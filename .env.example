# Database (Postgres — Vercel Postgres sets these automatically in production)
# For local dev: use a local Postgres or Neon free-tier connection string
POSTGRES_PRISMA_URL="postgresql://user:password@host:5432/dbname?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host:5432/dbname"

# GitHub OAuth App credentials
# Create at: https://github.com/organizations/<org>/settings/applications
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GitHub Personal Access Token (org admin)
# Scopes required: repo, admin:org, read:org
GH_ADMIN_TOKEN=""

# GitHub org name (the org where repos will be created)
GITHUB_ORG=""

# NextAuth secret — run: openssl rand -base64 32
NEXTAUTH_SECRET=""
# In production set to your public URL, e.g. https://repo-creation.example.com
NEXTAUTH_URL="http://localhost:3000"

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=""
# Sender address — must be a verified domain in Resend (free tier: onboarding@resend.dev)
EMAIL_FROM="Repo Requests <noreply@yourdomain.com>"

# Admin notification email (receives alerts when new requests arrive)
ADMIN_EMAIL=""
